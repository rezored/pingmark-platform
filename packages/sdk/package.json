{
	"name": "@pingmark/sdk",
	"version": "0.2.0",
	"description": "Parse, format and reason about Pingmark (!@) spatial mentions: tokens, resolver links, geo: URIs, precision levels and distances.",
	"keywords": [
		"pingmark",
		"location",
		"geolocation",
		"spatial",
		"geo-uri",
		"protocol",
		"privacy"
	],
	"homepage": "https://pingmark.me",
	"bugs": {
		"url": "https://github.com/rezored/pingmark-platform/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rezored/pingmark-platform.git",
		"directory": "packages/sdk"
	},
	"license": "MIT",
	"author": "Kalin Dimitrov",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsup src/index.ts --dts --format esm,cjs --clean",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"tsup": "^8.5.0",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
